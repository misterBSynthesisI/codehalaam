# --- Local development ---
# Use a local MongoDB or MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/codehalaam
PORT=5000
JWT_SECRET=change_this_secret
CLIENT_URL=http://localhost:5174
NODE_ENV=development

# --- File uploads (Vercel Blob) ---
# Optional in local dev (falls back to disk storage under server/uploads).
# Required on Vercel for persistent uploads. Create a blob store at:
#   https://vercel.com/dashboard/stores
# then copy the "Read and Write Access Token".
BLOB_READ_WRITE_TOKEN=

# --- Vercel deployment (set these in the Vercel dashboard) ---
# MONGODB_URI            -> your MongoDB Atlas connection string
#                          (e.g. mongodb+srv://user:pass@cluster.mongodb.net/codehalaam)
# JWT_SECRET             -> a long random string
# CLIENT_URL             -> your Vercel app URL (e.g. https://your-app.vercel.app)
# NODE_ENV               -> production
# BLOB_READ_WRITE_TOKEN  -> your Vercel Blob store token (for persistent uploads)
#
# Notes:
#   - Socket.io realtime is disabled on Vercel serverless; local dev keeps
#     full WebSocket support.
#   - With BLOB_READ_WRITE_TOKEN set, uploads (avatars, codex media, project
#     files up to 30 MB) persist in Vercel Blob (free tier: 1 GB storage).
#     Without it, uploads go to local disk (ephemeral on Vercel).
#   - First-run setup: visit /setup on a fresh deployment to create the
#     admin account. The setup page auto-disables once any user exists.
