{
  "name": "thegithub-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch index.js",
    "start": "node index.js",
    "seed": "node seed.js",
    "health": "node -e \"fetch('http://localhost:5000/api/health').then(r => r.json()).then(d => console.log(JSON.stringify(d, null, 2))).catch(e => console.error('Server not reachable:', e.message))\"",
    "db:init": "node scripts/init-db.js",
    "db:seed-notifications": "node scripts/seed-notifications.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1",
    "socket.io": "^4.8.3"
  }
}
